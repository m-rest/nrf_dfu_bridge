#!/usr/bin/env python3
"""Launch the installed nRF DFU bridge agent with its local configuration."""

from __future__ import annotations

import os
import sys
from pathlib import Path


home = Path.home()
app_dir = home / ".local" / "share" / "nrf-dfu-bridge"
python = app_dir / "venv" / "bin" / "python"
agent = app_dir / "nrf_serial_agent.py"
config = home / ".config" / "nrf-dfu-bridge" / "xiao_nrf52840.json"

if not python.is_file():
    print(f"nRF DFU Bridge virtual environment not found: {python}", file=sys.stderr)
    print("Run mac-agent/install-mac-agent.sh again.", file=sys.stderr)
    raise SystemExit(1)

if not agent.is_file():
    print(f"nRF DFU Bridge agent not found: {agent}", file=sys.stderr)
    print("Run mac-agent/install-mac-agent.sh again.", file=sys.stderr)
    raise SystemExit(1)

os.execv(
    str(python),
    [str(python), str(agent), "--config", str(config), "-vv", *sys.argv[1:]],
)
